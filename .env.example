# Copy to .env. The compose stack in docker-compose.yml matches these values,
# though this machine has no Docker — see docs/DEPLOY.md for the cloud setup.
DATABASE_URL=postgres://dahab:dahab@localhost:5432/dahab_focal
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development

# Signs session tokens. Generate with: openssl rand -base64 48
#
# The API refuses to start if this is missing, shorter than 32 characters, or
# still this placeholder in production. Rotating it signs every session out at
# once, which is the intended blast radius.
AUTH_SECRET=replace-me-before-running-anywhere-real

# OTP delivery. `console` prints the code to the log in development; the real
# gateway is swapped in behind the OtpTransport interface. The API refuses to
# start in production while this is `console`.
OTP_TRANSPORT=console

# Browser origins allowed to call the API, comma separated. The admin console
# renders on a server and needs no entry here; the vendor and traveller apps
# will. An origin not listed gets no CORS headers rather than a permissive
# one, and `*` beside credentials is never emitted.
CORS_ORIGINS=

# The admin console talks to the API over HTTP like every other surface.
DAHAB_API_URL=http://127.0.0.1:4000

# Staff accounts are created by `pnpm staff:create --email … --role admin`.
# The password comes from a muted prompt, or from STAFF_PASSWORD when there is
# no TTY — never from a command-line argument, which lands in shell history
# and in the process list.
#
# There is deliberately no service token here any more: the console carries
# the signed-in operator's own session, so the audit log can name them.
