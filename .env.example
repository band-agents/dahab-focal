# Copy to .env. The compose stack in docker-compose.yml matches these values.
DATABASE_URL=postgres://dahab:dahab@localhost:5432/dahab_focal
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development
# Sign session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-before-running-anywhere-real

# OTP delivery. `console` prints the code to the log in development; the real
# gateway is swapped in behind the OtpTransport interface.
OTP_TRANSPORT=console

# The admin console talks to the API over HTTP like every other surface.
DAHAB_API_URL=http://127.0.0.1:4000
# A session token with the admin role, for the console's server-side calls.
DAHAB_ADMIN_TOKEN=
