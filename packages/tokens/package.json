{
  "name": "@dahab/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.json": "./tokens.json",
    "./theme": "./src/generated/theme.ts",
    "./tokens.css": "./src/generated/tokens.css",
    "./tailwind-preset": "./src/generated/tailwind-preset.cjs",
    "./fonts.css": "./src/generated/fonts.css",
    "./fonts/*": "./fonts/*",
    "./marks": "./src/marks.ts"
  },
  "files": [
    "tokens.json",
    "src",
    "fonts"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-tokens.mjs --check && vitest run",
    "fonts": "node scripts/fetch-fonts.mjs && node scripts/build-tokens.mjs",
    "marks": "node scripts/generate-marks.mjs"
  },
  "devDependencies": {
    "@dahab/config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
