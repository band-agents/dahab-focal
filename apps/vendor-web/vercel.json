{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile --filter @dahab/vendor-web...",
  "buildCommand": "cd ../.. && pnpm --filter @dahab/tokens build && pnpm --filter @dahab/vendor-web build",
  "outputDirectory": ".next",
  "regions": [
    "dub1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
